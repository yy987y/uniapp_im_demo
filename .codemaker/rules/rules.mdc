## 3. 快速参考与上下文映射

### 3.1 核心工具函数签名 (utils/nim-sdk.js)

```javascript
// SDK 初始化与实例管理
export function initNIM(options?: {
  appkey: string,
  debugLevel?: 'off' | 'debug' | 'log',
  lbsUrls?: string[],
  linkUrl?: string,
  customClientType?: number,
  customTag?: string,
  isFixedDeviceId?: boolean
}): NIMInstance

export function getNIM(): NIMInstance | null
export async function destroyNIM(): Promise<void>
export function isInitialized(): boolean

// 日志管理
export function setLogCallback(callback: (log: LogEntry) => void): void
export function getLogger(): Logger

// 登录服务封装
export async function login(accountId: string, token: string, loginOption?: object): Promise<void>
export async function logout(): Promise<void>
export function getLoginUser(): string | null
export function getLoginStatus(): number | null  // 0=未登录, 1=已登录, 2=登录中, 3=退避中
export function getConnectStatus(): number | null // 0=未连接, 1=已连接, 2=连接中, 3=等待重连
export function getCurrentLoginClient(): object | null
export function getLoginClients(): object[]
export async function kickOffline(client: object): Promise<void>
export function getKickedOfflineDetail(): object | null
export function getDataSync(): object | null

// 事件监听
export function registerLoginListeners(callbacks: {
  onLoginStatus?: Function,
  onLoginFailed?: Function,
  onKickedOffline?: Function,
  onLoginClientChanged?: Function,
  onConnectStatus?: Function,
  onDisconnected?: Function,
  onConnectFailed?: Function,
  onDataSync?: Function
}): void
export function removeLoginListeners(): void
```

